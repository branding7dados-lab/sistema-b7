{
    "_comment": "Egg do Evolution API v2.3.7 para o Sistema B7 (piloto). Importar em Admin -> Nests -> Import Egg.",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-11-16T22:30:00-03:00",
    "name": "Evolution API (Sistema B7)",
    "author": "egg@branding7.com.br",
    "description": "Servidor do WhatsApp (Evolution API v2.3.7) para a Central de Conversas do Sistema B7. Banco MySQL do painel, cache local, chave da API gerada sozinha em .b7-chave.",
    "features": null,
    "docker_images": {
        "Node 22": "ghcr.io/parkervcp/yolks:nodejs_22"
    },
    "file_denylist": [],
    "startup": "if [ ! -f .b7-chave ]; then node -e 'process.stdout.write(require(\"crypto\").randomBytes(24).toString(\"hex\"))' > .b7-chave; fi; export AUTHENTICATION_API_KEY=$(cat .b7-chave); P=$(node -e 'process.stdout.write(encodeURIComponent(process.env.DB_PASS||\"\"))'); if [ \"$DATABASE_PROVIDER\" = \"postgresql\" ]; then export DATABASE_CONNECTION_URI=\"postgresql://${DB_USER}:${P}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=evolution\"; else export DATABASE_CONNECTION_URI=\"mysql://${DB_USER}:${P}@${DB_HOST}:${DB_PORT}/${DB_NAME}\"; fi; if [ \"$(cat .b7-banco 2>/dev/null)\" != \"$DATABASE_PROVIDER\" ]; then npm run db:generate && echo -n \"$DATABASE_PROVIDER\" > .b7-banco; fi; export SERVER_URL=$EVO_URL; if [ -z \"$SERVER_URL\" ]; then export SERVER_URL=http://localhost:$SERVER_PORT; fi; npm run db:deploy && node dist/main",
    "config": {
        "files": "{}",
        "startup": "{\n    \"done\": \"HTTP - ON\"\n}",
        "logs": "{}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Instala o Evolution API v2.3.7 (Sistema B7) na pasta do servidor.\nset -e\napt-get update -qq && apt-get install -y -qq git ca-certificates openssl > /dev/null\ncd /mnt/server\nif [ ! -f package.json ]; then\n  rm -rf /tmp/evo && git clone --depth 1 -b 2.3.7 https://github.com/EvolutionAPI/evolution-api.git /tmp/evo\n  cp -a /tmp/evo/. /mnt/server/ && rm -rf /tmp/evo\nfi\nexport NODE_OPTIONS=--max-old-space-size=1536\nnpm ci --no-audit --no-fund\nDATABASE_PROVIDER=mysql npm run db:generate\nnpx tsup\necho \"== Evolution instalado. Agora: aba Databases -> criar banco; aba Startup -> preencher DB_*; Start.\"\n",
            "container": "node:22-bookworm",
            "entrypoint": "bash"
        }
    },
    "variables": [
