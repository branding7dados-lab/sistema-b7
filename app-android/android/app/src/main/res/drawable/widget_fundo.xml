<?xml version="1.0" encoding="utf-8"?>
<!-- fundo do widget "Hoje no B7": azul-noite com dois brilhos da marca
     (magenta no alto à direita, azul embaixo à esquerda) e um fio de luz na borda -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:startColor="#1C1238" android:centerColor="#120C27" android:endColor="#0B0A1E" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="72%p" android:centerX="0.95" android:centerY="0.02"
                android:startColor="#66D63384" android:centerColor="#1FD63384" android:endColor="#00D63384" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="80%p" android:centerX="0.02" android:centerY="1.0"
                android:startColor="#553341D6" android:centerColor="#183341D6" android:endColor="#003341D6" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
