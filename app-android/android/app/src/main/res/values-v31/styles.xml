<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: o símbolo se monta (bulbo acende, a base sobe, as bolhas
         saem uma a uma) e a marca Branding7 fica no rodapé -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/b7_noite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/b7_abertura_animada</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/b7_abertura_marca</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
