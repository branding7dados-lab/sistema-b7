<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- tela do app: o céu da abertura enquanto o site carrega (sem flash branco) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/b7_ceu</item>
        <item name="android:statusBarColor">@color/b7_ceu</item>
        <item name="android:navigationBarColor">@color/b7_ceu</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- abertura do Android = o céu da abertura do sistema, sem ícone: a abertura
         escolhida (a mesma do site) começa por baixo e assume sem emenda -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/b7_ceu</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/b7_abertura_vazio</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
