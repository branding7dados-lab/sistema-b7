<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- tela do app: fundo azul-noite enquanto o site carrega (sem flash branco) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/b7_noite</item>
        <item name="android:statusBarColor">@color/b7_noite</item>
        <item name="android:navigationBarColor">@color/b7_noite</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- abertura: o símbolo da B7 em vetor, nítido em qualquer tela. Até o
         Android 11 ele aparece parado (values-v31 tem a versão animada). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/b7_noite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/b7_abertura_estatica</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
