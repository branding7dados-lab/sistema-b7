<?xml version="1.0" encoding="utf-8"?>
<!-- widget "Hoje no B7" (WidgetHoje.java): saudação, os três números do dia,
     o destaque (próxima gravação ou alerta) e os atalhos. Em widget baixo
     os atalhos somem (WidgetHoje escolhe pela altura). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:adjustViewBounds="true"
            android:contentDescription="B7"
            android:src="@drawable/widget_simbolo" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Hoje no B7"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:id="@+id/w_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#B9AEDD"
                android:textSize="11.5sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/w_atualizar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_botao"
            android:padding="8dp"
            android:contentDescription="Atualizar"
            android:src="@drawable/wi_atualizar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_blocos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="74dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_bloco1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            
            android:background="@drawable/widget_bloco_azul"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/w_ic1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_chip_azul"
                    android:padding="5dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/w_num1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="–"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/w_rot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:textColor="#D9D0F5"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_bloco2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_bloco_violeta"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/w_ic2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_chip_violeta"
                    android:padding="5dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/w_num2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="–"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/w_rot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:textColor="#D9D0F5"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_bloco3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_bloco_magenta"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/w_ic3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_chip_magenta"
                    android:padding="5dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/w_num3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="–"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
            <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/w_rot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:textColor="#D9D0F5"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_destaque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_linha"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/w_destaque_ic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_chip_azul"
            android:padding="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/wi_camera" />
        <TextView
            android:id="@+id/w_proxima"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp" />
        <TextView
            android:id="@+id/w_rodape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#8F86B3"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_botoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_bt_hoje"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_botao_pri"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wi_casa" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Painel"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_bt_grav"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_botao"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wi_grav" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Gravações"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_bt_ideia"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_botao"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wi_ideia" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ideia"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_bt_tele"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_botao"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wi_tele" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Prompter"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
